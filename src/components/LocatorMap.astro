---
/* Static locator map: highlights one or more places and optionally joins them as a route. No client JS. */
import { PLACES, placeBySlug, CATEGORIES } from '../data/places';
import { bhutanMap } from '../lib/geo';
import { url } from '../lib/site';

interface Props { highlight: string[]; route?: boolean; label?: string }
const { highlight, route = false, label = 'Location in Bhutan' } = Astro.props;
const W = 600, H = 340;
const { outline, xy } = bhutanMap(W, H, 24);
const hi = highlight.map(placeBySlug).filter((p): p is NonNullable<typeof p> => !!p);
const pts = hi.map((p) => xy(p.lon, p.lat));
const routeD = route && pts.length > 1 ? 'M' + pts.map((p) => p.map((n) => n.toFixed(1)).join(',')).join(' L') : '';
const others = PLACES.filter((p) => !highlight.includes(p.slug));
---
<figure class="loc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}: ${hi.map((p) => p.name).join(', ')}`}>
    <path d={outline} fill="#1b2724" stroke="rgba(231,163,62,.5)" stroke-width="1.2" />
    {others.map((p) => { const [x, y] = xy(p.lon, p.lat); return <circle cx={x} cy={y} r="2.5" fill="rgba(169,180,181,.35)" />; })}
    {routeD && <path d={routeD} fill="none" stroke="#e7a33e" stroke-width="1.6" stroke-dasharray="4 5" stroke-linejoin="round" />}
    {hi.map((p, i) => { const [x, y] = pts[i]; return (
      <g>
        <circle cx={x} cy={y} r="11" fill={CATEGORIES[p.cat].color} opacity=".18" />
        <circle cx={x} cy={y} r="5.5" fill={CATEGORIES[p.cat].color} stroke="#0a0e11" stroke-width="2" />
        {(hi.length <= 3 || route) && hi.length <= 8 && <text x={x + 9} y={y - 8} class="lbl">{hi.length > 1 && route ? `${i + 1}` : p.name}</text>}
      </g>
    ); })}
  </svg>
  {route && hi.length > 1 && (
    <figcaption><ol>{hi.map((p) => <li><a href={url(`/places/${p.slug}/`)}>{p.name}</a></li>)}</ol></figcaption>
  )}
</figure>

<style>
  .loc { margin: 0; border: 1px solid var(--line); border-radius: 12px; background: radial-gradient(120% 90% at 50% 40%, #142024 0%, #0b1013 70%); overflow: hidden; }
  svg { width: 100%; height: auto; }
  .lbl { font-family: var(--mono); font-size: 12px; fill: var(--snow); paint-order: stroke; stroke: rgba(10, 14, 17, 0.85); stroke-width: 3px; }
  figcaption { padding: 12px 16px 16px; border-top: 1px solid var(--line); }
  ol { margin: 0; padding-left: 1.4em; columns: 2; column-gap: 24px; font-size: 14px; color: var(--mist); }
  ol a { color: var(--snow); text-decoration: none; }
  ol a:hover { color: var(--saffron-hi); }
</style>
