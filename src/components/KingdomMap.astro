---
/* Interactive map of Bhutan. The SVG is drawn at build time; the client script only handles selection and filtering. */
import { PLACES, CATEGORIES, type Category } from '../data/places';
import { wonderIndex } from '../data/wonders';
import { bhutanMap } from '../lib/geo';
import { url } from '../lib/site';

interface Props { initial?: string }
const { initial = 'tigers-nest' } = Astro.props;
const W = 1000, H = 560;
const { outline, xy } = bhutanMap(W, H, 50);
const labelled = new Set(['tigers-nest', 'punakha-dzong', 'gangkhar-puensum', 'phobjikha-valley', 'jomolhari', 'bumthang', 'royal-manas', 'trashigang', 'thimphu']);
const neighbours: [string, number, number][] = [['TIBET (CHINA)', 90.2, 28.3], ['INDIA', 90.6, 26.66], ['SIKKIM', 88.85, 27.2], ['ARUNACHAL', 92.2, 27.75]];
const north: [number, number][] = [[89.2, 27.9], [89.5, 28.05], [89.8, 28.1], [90.1, 28.15], [90.4, 28.12], [90.7, 28.05], [91, 27.95], [91.3, 27.9]];
const a = xy(89.1, 26.62), b = xy(89.1 + 50 / (111.32 * Math.cos((26.62 * Math.PI) / 180)), 26.62);
const scaleW = b[0] - a[0];
const sel = PLACES.find((p) => p.slug === initial) ?? PLACES[0];
const data = PLACES.map((p) => ({
  slug: p.slug, name: p.name, tib: p.tib ?? '', cat: p.cat, alt: p.alt, district: p.district, lat: p.lat, lon: p.lon,
  summary: p.summary, tip: p.tip, scene: p.scene, kind: p.kind, night: p.night, w: p.w, wonder: wonderIndex(p.slug), href: url(`/places/${p.slug}/`),
}));
---
<div class="km">
  <div class="filters" role="group" aria-label="Filter places by type">
    {(Object.entries(CATEGORIES) as [Category, (typeof CATEGORIES)[Category]][]).map(([k, c]) => (
      <button class="chip" data-cat={k} aria-pressed="true" style={`--c:${c.color}`}><i></i>{c.label}</button>
    ))}
  </div>
  <div class="layout">
    <div class="box">
      <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of Bhutan. Use Tab to move between places and Enter to select one.">
        <defs>
          <linearGradient id="btg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4648" /><stop offset=".45" stop-color="#22302b" /><stop offset="1" stop-color="#1a2a20" /></linearGradient>
          <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="rgba(237,240,236,.05)" stroke-width="1.5" /></pattern>
        </defs>
        {[89, 90, 91, 92].map((lon) => { const p = xy(lon, 26.4), q = xy(lon, 28.5); return <g><line x1={p[0]} x2={q[0]} y1={p[1]} y2={q[1]} class="grat" /><text x={p[0] + 4} y={H - 12} class="glabel">{lon}°E</text></g>; })}
        {[27, 28].map((lat) => { const p = xy(88.5, lat); return <g><line x1="0" x2={W} y1={p[1]} y2={p[1]} class="grat" /><text x="10" y={p[1] - 5} class="glabel">{lat}°N</text></g>; })}
        {neighbours.map(([l, lo, la]) => { const q = xy(lo, la); return <text x={q[0]} y={q[1]} class="nb">{l}</text>; })}
        <path d={outline} fill="url(#btg)" stroke="rgba(231,163,62,.55)" stroke-width="1.4" />
        <path d={outline} fill="url(#hatch)" />
        {north.map(([lo, la]) => { const q = xy(lo, la); return <path d={`M${q[0] - 9},${q[1] + 6}L${q[0]},${q[1] - 8}L${q[0] + 9},${q[1] + 6}`} class="peakglyph" />; })}
        <g transform={`translate(${W - 40 - scaleW},${H - 28})`}><rect width={scaleW} height="3" fill="#a9b4b5" /><text y="-7" class="glabel" fill="#a9b4b5">50 km</text></g>
        <g transform={`translate(${W - 48},56)`}><path d="M0,-18L6,0L0,-4L-6,0Z" fill="#e7a33e" /><text y="14" text-anchor="middle" class="glabel">N</text></g>
        {PLACES.map((p) => { const [x, y] = xy(p.lon, p.lat); const w = wonderIndex(p.slug) >= 0; return (
          <g class:list={['pin', { sel: p.slug === sel.slug }]} data-slug={p.slug} data-cat={p.cat} transform={`translate(${x},${y})`} style={`--c:${CATEGORIES[p.cat].color}`} tabindex="0" role="button" aria-label={`${p.name}, ${p.alt}`}>
            <circle class="halo" r="12" />
            <circle class="dot" r={w ? 8 : 6} />
            {labelled.has(p.slug) && <text x="12" y="4" class="plabel">{p.name.toUpperCase()}</text>}
          </g>
        ); })}
      </svg>
      <div class="tip" aria-hidden="true"></div>
    </div>
    <article class="place" aria-live="polite">
      <canvas class="pcv" aria-hidden="true"></canvas>
      <div class="pbody">
        <span class="eyebrow pcat">{CATEGORIES[sel.cat].label}{wonderIndex(sel.slug) >= 0 && ` · Wonder ${String(wonderIndex(sel.slug) + 1).padStart(2, '0')}`}</span>
        <h3 class="display pname">{sel.name}</h3>
        <span class="tib ptib" lang="dz" hidden={!sel.tib}>{sel.tib}</span>
        <div class="tags pchips"><span class="tag">{sel.alt}</span><span class="tag">{sel.district}</span><span class="tag">{sel.lat.toFixed(2)}°N {sel.lon.toFixed(2)}°E</span></div>
        <p class="ptext">{sel.summary}</p>
        <div class="callout ptip"><b>DON'T MISS</b>{sel.tip}</div>
        <div class="pnav">
          <button class="btn ghost pprev" aria-label="Previous place">←</button>
          <a class="btn plink" href={url(`/places/${sel.slug}/`)}>Read the full guide</a>
          <button class="btn ghost pnext" aria-label="Next place">→</button>
        </div>
      </div>
    </article>
  </div>
  <script type="application/json" class="kmdata" set:html={JSON.stringify(data)} />
</div>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; margin-top: 22px; }
  .box { position: relative; border: 1px solid var(--line); border-radius: var(--radius); background: radial-gradient(120% 90% at 50% 40%, #142024 0%, #0b1013 70%); overflow: hidden; }
  svg { width: 100%; height: auto; }
  .grat { stroke: rgba(237, 240, 236, 0.06); }
  .glabel { font-family: var(--mono); font-size: 11px; fill: var(--fog); }
  .nb { font-family: var(--mono); font-size: 12px; letter-spacing: 0.3em; fill: rgba(169, 180, 181, 0.35); text-anchor: middle; }
  .peakglyph { fill: none; stroke: rgba(230, 236, 242, 0.25); stroke-width: 1.2; }
  .plabel { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; fill: var(--snow); pointer-events: none; paint-order: stroke; stroke: rgba(10, 14, 17, 0.8); stroke-width: 3px; }
  .pin { cursor: pointer; }
  .halo { fill: var(--c); opacity: 0.18; transform-box: fill-box; transform-origin: center; animation: halo 2.8s infinite; }
  .dot { fill: var(--c); stroke: var(--night); stroke-width: 2; transition: r 0.2s; }
  .pin.sel .dot { stroke: var(--snow); stroke-width: 2.5; }
  .pin.off { opacity: 0.12; pointer-events: none; }
  .pin:focus { outline: none; }
  .pin:focus-visible .dot { stroke: var(--saffron); stroke-width: 4; }
  @keyframes halo { 0% { transform: scale(0.6); opacity: 0.35; } 100% { transform: scale(2.2); opacity: 0; } }
  .tip { position: absolute; pointer-events: none; background: var(--snow); color: var(--night); font-size: 12.5px; font-weight: 600; padding: 5px 10px; border-radius: 4px; transform: translate(-50%, -140%); white-space: nowrap; opacity: 0; transition: opacity 0.15s; }
  .place { border: 1px solid var(--line); border-radius: var(--radius); background: var(--slate); overflow: hidden; position: sticky; top: calc(var(--nav-h) + 16px); }
  .pcv { width: 100%; aspect-ratio: 16 / 9; height: auto; background: #111; }
  .pbody { padding: 22px 24px 24px; display: grid; gap: 12px; }
  .pname { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .ptib { font-size: 20px; color: var(--mist); }
  .ptext { color: var(--mist); font-size: 15.5px; }
  .pnav { display: flex; justify-content: space-between; gap: 10px; padding-top: 6px; }
  .pnav .plink { flex: 1; justify-content: center; }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .place { position: relative; top: 0; } }
</style>

<script>
  import { buildScene, paintScene, specFromDataset, fitCanvas, whileVisible, type Scene } from '../lib/scenes';

  type P = { slug: string; name: string; tib: string; cat: string; alt: string; district: string; lat: number; lon: number; summary: string; tip: string; scene: string; kind?: string; night?: boolean; w?: number; wonder: number; href: string };
  const CAT: Record<string, string> = { sacred: 'Dzongs & temples', peaks: 'Peaks & passes', wild: 'Valleys & wildlife', towns: 'Towns & gateways' };

  document.querySelectorAll<HTMLElement>('.km').forEach((root) => {
    const data: P[] = JSON.parse(root.querySelector('.kmdata')!.textContent!);
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as unknown as T;
    const pins = [...root.querySelectorAll<SVGGElement>('.pin')];
    const tip = q('.tip'), box = q('.box'), svg = q<SVGSVGElement>('svg');
    const cv = q<HTMLCanvasElement>('.pcv'), ctx = cv.getContext('2d')!;
    const cache: Record<string, Scene> = {};
    let sel = Math.max(0, data.findIndex((p) => q('.pname').textContent === p.name));
    const active = new Set(Object.keys(CAT));
    const sceneFor = (p: P) => (cache[p.slug] ??= buildScene(specFromDataset({ scene: p.scene, kind: p.kind, seed: p.slug, night: p.night ? 'true' : undefined, w: p.w ? String(p.w) : undefined })));

    function select(i: number, focusPin = false) {
      const vis = data.map((p, j) => [p, j] as const).filter(([p]) => active.has(p.cat));
      if (!vis.length) return;
      sel = (i + data.length) % data.length;
      const p = data[sel];
      pins.forEach((g) => g.classList.toggle('sel', g.dataset.slug === p.slug));
      q('.pcat').textContent = CAT[p.cat] + (p.wonder >= 0 ? ` · Wonder ${String(p.wonder + 1).padStart(2, '0')}` : '');
      q('.pname').textContent = p.name;
      const t = q('.ptib'); t.textContent = p.tib; t.hidden = !p.tib;
      q('.pchips').innerHTML = [p.alt, p.district, `${p.lat.toFixed(2)}°N ${p.lon.toFixed(2)}°E`].map((x) => `<span class="tag">${x}</span>`).join('');
      q('.ptext').textContent = p.summary;
      q('.ptip').innerHTML = `<b>DON'T MISS</b>${p.tip}`;
      const a = q<HTMLAnchorElement>('.plink'); a.href = p.href;
      if (focusPin) pins.find((g) => g.dataset.slug === p.slug)?.focus();
    }
    function step(dir: number) {
      let i = sel;
      for (let k = 0; k < data.length; k++) { i = (i + dir + data.length) % data.length; if (active.has(data[i].cat)) break; }
      select(i);
    }
    pins.forEach((g) => {
      const i = data.findIndex((p) => p.slug === g.dataset.slug);
      g.addEventListener('click', () => select(i));
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(i); } });
      g.addEventListener('pointerenter', () => {
        const r = box.getBoundingClientRect(), s = svg.getBoundingClientRect(), m = g.getCTM()!;
        tip.textContent = `${data[i].name} · ${data[i].alt}`;
        tip.style.left = (m.e / 1000) * s.width + (s.left - r.left) + 'px';
        tip.style.top = (m.f / 560) * s.height + (s.top - r.top) + 'px';
        tip.style.opacity = '1';
      });
      g.addEventListener('pointerleave', () => (tip.style.opacity = '0'));
    });
    root.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.cat!;
      if (active.has(k)) { if (active.size > 1) active.delete(k); } else active.add(k);
      root.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.setAttribute('aria-pressed', String(active.has(c.dataset.cat!))));
      pins.forEach((g) => { const on = active.has(g.dataset.cat!); g.classList.toggle('off', !on); g.setAttribute('tabindex', on ? '0' : '-1'); });
      if (!active.has(data[sel].cat)) step(1);
    }));
    q('.pprev').addEventListener('click', () => step(-1));
    q('.pnext').addEventListener('click', () => step(1));
    whileVisible(cv, (t) => { const { W, H } = fitCanvas(cv); paintScene(ctx, W, H, sceneFor(data[sel]), t); });
    // Allow other components (e.g. "See it on the map") to select a place via the URL hash.
    const fromHash = () => { const s = location.hash.replace('#', ''); const i = data.findIndex((p) => p.slug === s); if (i >= 0) select(i); };
    addEventListener('hashchange', fromHash); fromHash();
  });
</script>
