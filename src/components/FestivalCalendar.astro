---
/* Month-by-month calendar. All twelve panels are rendered at build time; the script opens the current month and adds a countdown. */
import { MONTHS, SEASONS } from '../data/festivals';
import { placeBySlug } from '../data/places';
import { url } from '../lib/site';
interface Props { id?: string }
const { id = 'cal' } = Astro.props;
const buildMonth = new Date().getMonth();
const fixed = MONTHS.flatMap((m) => m.festivals.filter((f) => f.iso).map((f) => ({ iso: f.iso!, yearly: !!f.yearly, name: f.name })));
---
<div class="fc" id={id}>
  <div class="months" role="tablist" aria-label="Months">
    {MONTHS.map((m, i) => (
      <button role="tab" id={`${id}-t${i}`} aria-controls={`${id}-p${i}`} aria-selected={i === buildMonth ? 'true' : 'false'} tabindex={i === buildMonth ? 0 : -1} style={`--sc:${SEASONS[m.season].color}`}>
        <span class="m">{m.m}</span><span class="band"></span><span class="dots">{m.festivals.map(() => <i></i>)}</span>
      </button>
    ))}
  </div>
  <div class="key">
    {Object.values(SEASONS).map((s) => <span style={`--sc:${s.color}`}><i></i>{s.label}</span>)}
    <span><i class="fdot"></i>Festival</span>
  </div>
  {MONTHS.map((m, i) => (
    <div class="panel" role="tabpanel" id={`${id}-p${i}`} aria-labelledby={`${id}-t${i}`} hidden={i !== buildMonth}>
      <div>
        <h3 class="display mname">{m.name}</h3>
        <div class="sname">{SEASONS[m.season].label}<span class="now" hidden> · this month</span></div>
        <p class="desc">{m.text}</p>
        <div class="good">{m.goodFor.map((g) => <span>{g}</span>)}</div>
      </div>
      <div class="fests">
        {m.festivals.length ? m.festivals.map((f) => (
          <div class="fest">
            <div class="d">{f.date}</div>
            <div>
              <h4>{f.name}</h4>
              <p>{f.text}</p>
              {f.place && placeBySlug(f.place) && <a class="link-arrow" href={url(`/places/${f.place}/`)}>{placeBySlug(f.place)!.name} <span>→</span></a>}
            </div>
          </div>
        )) : <div class="fest none">No major festivals this month, which means fewer visitors and easier bookings.</div>}
      </div>
    </div>
  ))}
  <div class="next" hidden></div>
  <script type="application/json" class="fcdata" set:html={JSON.stringify(fixed)} />
</div>

<style>
  .months { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px; }
  .months button { border: 0; background: none; padding: 0 0 10px; display: grid; gap: 8px; text-align: left; color: var(--fog); }
  .m { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; padding-left: 2px; }
  .band { height: 6px; border-radius: 3px; background: var(--sc); opacity: 0.45; transition: opacity 0.2s, height 0.2s; }
  .dots { display: flex; gap: 3px; height: 6px; padding-left: 2px; }
  .dots i, .fdot { width: 6px; height: 6px; border-radius: 50%; background: var(--saffron); display: inline-block; }
  .months button[aria-selected='true'] { color: var(--snow); }
  .months button[aria-selected='true'] .band { opacity: 1; height: 10px; }
  .months button:hover .band { opacity: 0.8; }
  .key { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; font-size: 13px; color: var(--mist); }
  .key span { display: inline-flex; align-items: center; gap: 8px; }
  .key i:not(.fdot) { width: 18px; height: 6px; border-radius: 3px; background: var(--sc); }
  .panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 64px); margin-top: 40px; padding-top: 36px; border-top: 1px solid var(--line); }
  .mname { font-size: clamp(2.6rem, 6vw, 5rem); }
  .sname { font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--saffron); margin-top: 12px; }
  .desc { color: var(--mist); margin-top: 16px; max-width: 52ch; }
  .good { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .good span { font-size: 13px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line-2); }
  .fests { display: grid; gap: 10px; align-content: start; }
  .fest { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 16px; padding: 16px 18px; border-radius: 6px; background: var(--slate); border: 1px solid var(--line); }
  .fest > div { display: grid; gap: 6px; justify-items: start; }
  .d { font-family: var(--mono); font-size: 12.5px; color: var(--saffron); line-height: 1.4; }
  h4 { margin: 0; font-family: var(--display); font-stretch: 112%; font-size: 1.05rem; }
  .fest p { color: var(--mist); font-size: 14.5px; }
  .fest.none { grid-template-columns: 1fr; color: var(--mist); font-size: 15px; }
  .next { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; margin-top: 22px; padding: 16px 20px; border-radius: 6px; border: 1px solid rgba(231, 163, 62, 0.35); background: rgba(231, 163, 62, 0.06); }
  .next :global(.n) { font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 2rem; color: var(--saffron); font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) { .months { grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: 14px; } .panel { grid-template-columns: minmax(0, 1fr); } .fest { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.fc').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const now = new Date();
    let sel = now.getMonth();
    function show(i: number, focus = false) {
      sel = (i + 12) % 12;
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === sel)); t.tabIndex = j === sel ? 0 : -1; });
      panels.forEach((p, j) => (p.hidden = j !== sel));
      if (focus) tabs[sel].focus();
    }
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    root.querySelector('.months')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight' || k === 'ArrowLeft') { e.preventDefault(); show(sel + (k === 'ArrowRight' ? 1 : -1), true); }
      if (k === 'Home') { e.preventDefault(); show(0, true); }
      if (k === 'End') { e.preventDefault(); show(11, true); }
    });
    panels[now.getMonth()].querySelector<HTMLElement>('.now')!.hidden = false;
    show(sel);

    const fixed = JSON.parse(root.querySelector('.fcdata')!.textContent!) as { iso: string; yearly: boolean; name: string }[];
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const up = fixed.map((f) => {
      const d = new Date(f.iso + 'T00:00:00');
      if (f.yearly) { d.setFullYear(today.getFullYear()); if (d < today) d.setFullYear(today.getFullYear() + 1); }
      return { d, f };
    }).filter((x) => x.d >= today).sort((a, b) => +a.d - +b.d)[0];
    const next = root.querySelector<HTMLElement>('.next')!;
    if (up) {
      const days = Math.round((+up.d - +today) / 864e5);
      next.innerHTML = `<span class="eyebrow">Next fixed-date festival</span><span class="n">${days === 0 ? 'Today' : days === 1 ? '1 day' : days + ' days'}</span><span><b>${up.f.name}</b> · <span style="color:var(--mist)">${up.d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span></span>`;
      next.hidden = false;
    }
  });
</script>
