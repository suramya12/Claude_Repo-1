---
import { WONDERS } from '../data/wonders';
import { placeBySlug } from '../data/places';
import { url } from '../lib/site';
const first = WONDERS[0];
const firstPlace = placeBySlug(first.slug)!;
const data = WONDERS.map((w) => ({ ...w, tib: placeBySlug(w.slug)?.tib ?? '', scene: placeBySlug(w.slug)!.scene, href: url(`/places/${w.slug}/`) }));
---
<section id="wonders" class="wonders" aria-roledescription="carousel" aria-label="Seven wonders of Bhutan">
  <canvas class="ambient" id="ambient" aria-hidden="true"></canvas>
  <div class="frame" id="frame">
    <canvas id="scene" role="img" aria-label={`Illustration of ${firstPlace.name}`}></canvas>
    <div class="top">
      <span class="tag">SEVEN WONDERS<i>.</i></span>
      <div class="thumbs" id="thumbs" role="tablist" aria-label="Choose a wonder">
        {WONDERS.map((w, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={w.title.join(' ')}><b></b></button>)}
      </div>
    </div>
    <div class="main">
      <div class="num" id="wNum">Wonder 01 / 07</div>
      <h2 class="display title" id="wTitle">{first.title.map((l) => <span class="ln"><span>{l}</span></span>)}</h2>
      <div class="sub" id="wSub"><span class="tib" lang="dz">{firstPlace.tib}</span><span>{first.sub}</span></div>
      <div class="actions">
        <button class="play" id="playBtn" aria-pressed="false"><span class="ring"><svg viewBox="0 0 16 16" aria-hidden="true"><path id="playIcon" d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg></span><span id="playTxt">Play the journey</span></button>
        <a class="btn" id="wLink" href={url(`/places/${first.slug}/`)}>Explore {firstPlace.name}</a>
      </div>
    </div>
    <aside class="card" id="wCard" aria-live="polite">
      <h3 id="cTitle">{first.title.join(' ')}</h3>
      <p id="cText">{first.card}</p>
      <dl class="meta" id="cMeta">{first.meta.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl>
    </aside>
    <div class="vrail">
      <button id="railPrev" aria-label="Previous wonder">01</button>
      <div class="bar"><b id="railBar"></b></div>
      <button id="railNext" aria-label="Next wonder">07</button>
    </div>
    <div class="bottom">
      <div class="links"><button id="prevW">← Prev</button><button id="nextW">Next →</button><a href={url('/wonders/')}>All seven</a></div>
      <div class="stats" id="wStats">{first.stats.map(([v, u, l]) => <div><b>{v}{u && <small>{u}</small>}</b><span>{l}</span></div>)}</div>
    </div>
  </div>
  <script type="application/json" id="wondersData" set:html={JSON.stringify(data)} />
</section>

<style>
  .wonders { position: relative; padding-block: clamp(40px, 6vw, 90px); overflow: hidden; }
  .ambient { position: absolute; inset: -10%; width: 120%; height: 120%; filter: blur(48px) saturate(0.9) brightness(0.55); opacity: 0.9; pointer-events: none; }
  .frame { position: relative; margin-inline: var(--gutter); border-radius: var(--radius); overflow: hidden; height: clamp(640px, 92vh, 900px); box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.85), 0 0 0 1px var(--line); background: var(--slate); isolation: isolate; max-width: 1600px; }
  @media (min-width: 1700px) { .frame { margin-inline: auto; } }
  #scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(6, 9, 11, 0.78) 0%, rgba(6, 9, 11, 0.35) 42%, rgba(6, 9, 11, 0) 70%), linear-gradient(0deg, rgba(6, 9, 11, 0.85) 0%, rgba(6, 9, 11, 0) 38%); pointer-events: none; z-index: 1; }
  .top { position: absolute; inset: 0 0 auto 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; padding: 22px clamp(18px, 3vw, 40px); }
  .tag { font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 13px; letter-spacing: 0.1em; }
  .tag i { font-style: normal; color: var(--saffron); }
  .thumbs { display: flex; gap: 6px; }
  .thumbs button { width: 34px; height: 18px; border: 0; padding: 7px 0; background: none; position: relative; }
  .thumbs button::before { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 4px; border-radius: 2px; background: rgba(237, 240, 236, 0.22); }
  .thumbs button :global(b) { position: absolute; left: 0; right: 0; top: 7px; height: 4px; border-radius: 2px; background: var(--saffron); transform: scaleX(0); transform-origin: left; }
  .main { position: absolute; z-index: 3; left: clamp(18px, 6vw, 96px); top: 50%; transform: translateY(-58%); max-width: min(640px, 80%); }
  .num { font-family: var(--mono); font-size: 12px; letter-spacing: 0.2em; color: var(--saffron); text-transform: uppercase; }
  .title { font-size: clamp(2.6rem, 7vw, 6.2rem); margin: 14px 0 6px; }
  .title :global(.ln) { display: block; overflow: hidden; }
  .title :global(.ln span) { display: inline-block; transition: transform 0.9s var(--ease), opacity 0.9s; }
  .title:global(.out) :global(.ln span) { transform: translateY(105%); opacity: 0; transition-duration: 0.35s; }
  .sub { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; color: var(--mist); font-size: 15px; }
  .sub :global(.tib) { font-size: 22px; color: var(--snow); opacity: 0.85; }
  .actions { display: flex; flex-wrap: wrap; gap: 22px; align-items: center; margin-top: 30px; }
  .play { display: flex; align-items: center; gap: 14px; background: none; border: 0; padding: 0; font-family: var(--display); font-stretch: 112%; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .ring { width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--snow); display: grid; place-items: center; transition: background 0.3s; }
  .play:hover .ring { background: rgba(237, 240, 236, 0.1); }
  .play svg { width: 16px; height: 16px; }
  .card { position: absolute; z-index: 3; right: clamp(64px, 8vw, 120px); top: 52%; width: min(300px, 30vw); background: rgba(18, 25, 29, 0.62); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--line); border-radius: 6px; padding: 20px 22px; transition: opacity 0.5s, transform 0.5s; }
  .card:global(.out) { opacity: 0; transform: translateY(10px); }
  .card h3 { font-stretch: 125%; font-weight: 800; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 8px; }
  .card p { font-size: 13.5px; line-height: 1.55; color: var(--mist); }
  .meta { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12px; }
  .meta :global(dt) { font-family: var(--mono); color: var(--fog); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; padding-top: 2px; }
  .meta :global(dd) { margin: 0; }
  .vrail { position: absolute; z-index: 3; right: clamp(18px, 3vw, 40px); top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .bar { width: 2px; height: 150px; background: rgba(237, 240, 236, 0.2); position: relative; border-radius: 2px; }
  .bar b { position: absolute; left: 0; right: 0; top: 0; height: 14.28%; background: var(--snow); border-radius: 2px; transition: top 0.6s var(--ease); }
  .vrail button { background: none; border: 0; padding: 4px; color: var(--fog); font-family: var(--mono); font-size: 11px; }
  .vrail button:hover { color: var(--snow); }
  .bottom { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 24px clamp(18px, 6vw, 96px) 28px; flex-wrap: wrap; }
  .links { display: flex; gap: 28px; font-family: var(--display); font-stretch: 112%; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--mist); }
  .links button, .links a { background: none; border: 0; padding: 0; letter-spacing: inherit; text-transform: inherit; color: inherit; text-decoration: none; }
  .links button:hover, .links a:hover { color: var(--snow); }
  .stats { display: flex; gap: clamp(24px, 5vw, 72px); margin-right: clamp(0px, 6vw, 90px); }
  .stats :global(div) { transition: opacity 0.5s, transform 0.5s; }
  .stats:global(.out) :global(div) { opacity: 0; transform: translateY(8px); }
  .stats :global(b) { display: block; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: clamp(1.5rem, 2.6vw, 2.2rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .stats :global(b small) { font-size: 0.5em; font-weight: 500; margin-left: 3px; color: var(--mist); }
  .stats :global(span) { font-size: 12.5px; color: var(--mist); }
  @media (max-width: 900px) {
    .frame { height: auto; display: flex; flex-direction: column; }
    #scene { position: relative; height: 56vh; min-height: 340px; }
    .frame::after { background: linear-gradient(0deg, rgba(6, 9, 11, 1) 0%, rgba(6, 9, 11, 0) 30%); height: 56vh; min-height: 340px; }
    .main { position: relative; left: auto; top: auto; transform: none; max-width: none; padding: 0 18px; margin-top: -120px; }
    .card { position: relative; right: auto; top: auto; width: auto; margin: 22px 18px 0; }
    .vrail, .tag { display: none; }
    .top { justify-content: flex-end; }
    .bottom { position: relative; padding: 22px 18px 26px; flex-direction: column-reverse; align-items: stretch; }
    .stats { margin: 0; justify-content: space-between; }
  }
</style>

<script>
  import { buildScene, paintScene, specFromDataset, fitCanvas, whileVisible, reducedMotion, ease, clamp } from '../lib/scenes';

  type W = { slug: string; title: string[]; sub: string; card: string; meta: [string, string][]; stats: [string, string, string][]; tib: string; scene: string; href: string };
  const data: W[] = JSON.parse(document.getElementById('wondersData')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const cv = $('scene') as HTMLCanvasElement, ctx = cv.getContext('2d')!;
  const amb = $('ambient') as HTMLCanvasElement, actx = amb.getContext('2d')!;
  const scenes = data.map((w) => buildScene(specFromDataset({ scene: w.scene })));
  const thumbs = [...$('thumbs').children] as HTMLButtonElement[];
  const DUR = 8;
  let idx = 0, prev = -1, fadeT = 1, playing = false, slideT = 0, mx = 0, tmx = 0, last = 0, started = false;

  function render() {
    const w = data[idx];
    $('wNum').textContent = `Wonder ${String(idx + 1).padStart(2, '0')} / 07`;
    const T = $('wTitle'), C = $('wCard'), St = $('wStats');
    [T, C, St].forEach((e) => e.classList.add('out'));
    cv.setAttribute('aria-label', `Illustration of ${w.title.join(' ')}`);
    setTimeout(() => {
      T.innerHTML = w.title.map((l) => `<span class="ln"><span>${l}</span></span>`).join('');
      $('wSub').innerHTML = `<span class="tib" lang="dz">${w.tib}</span><span>${w.sub}</span>`;
      $('cTitle').textContent = w.title.join(' ');
      $('cText').textContent = w.card;
      $('cMeta').innerHTML = w.meta.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join('');
      St.innerHTML = w.stats.map(([v, u, l]) => `<div><b>${v}${u ? `<small>${u}</small>` : ''}</b><span>${l}</span></div>`).join('');
      const link = $('wLink') as HTMLAnchorElement; link.href = w.href; link.textContent = `Explore ${w.title.join(' ')}`;
      requestAnimationFrame(() => [T, C, St].forEach((e) => e.classList.remove('out')));
    }, reducedMotion() ? 0 : 340);
    thumbs.forEach((b, i) => { b.setAttribute('aria-selected', String(i === idx)); (b.firstElementChild as HTMLElement).style.transform = i < idx ? 'scaleX(1)' : 'scaleX(0)'; });
    $('railBar').style.top = (idx / 7) * 100 + '%';
    $('railPrev').textContent = String(idx + 1).padStart(2, '0');
  }
  function go(i: number) { prev = idx; idx = (i + 7) % 7; fadeT = 0; slideT = 0; render(); }
  thumbs.forEach((b, i) => (b.onclick = () => go(i)));
  $('prevW').onclick = $('railPrev').onclick = () => go(idx - 1);
  $('nextW').onclick = $('railNext').onclick = () => go(idx + 1);
  function setPlay(v: boolean) {
    playing = v; $('playBtn').setAttribute('aria-pressed', String(v));
    $('playTxt').textContent = v ? 'Pause the journey' : 'Play the journey';
    $('playIcon').setAttribute('d', v ? 'M4 2.5h3v11H4zM9 2.5h3v11H9z' : 'M4 2.5v11l9-5.5z');
  }
  $('playBtn').onclick = () => { setPlay(!playing); slideT = 0; };
  const fr = $('frame');
  fr.addEventListener('pointermove', (e) => { const r = fr.getBoundingClientRect(); tmx = ((e.clientX - r.left) / r.width) * 2 - 1; });
  fr.addEventListener('pointerleave', () => (tmx = 0));
  fr.addEventListener('focusin', () => playing && setPlay(false));
  let sx: number | null = null;
  fr.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
  fr.addEventListener('touchend', (e) => { if (sx == null) return; const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) go(idx + (dx < 0 ? 1 : -1)); sx = null; });
  fr.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(idx + 1); if (e.key === 'ArrowLeft') go(idx - 1); });
  new IntersectionObserver((es) => { if (es[0].isIntersecting && !reducedMotion() && !started) { started = true; setPlay(true); } }, { threshold: 0.5 }).observe(fr);
  let aT = 0;
  whileVisible(fr, (t) => {
    const dt = Math.min(0.05, t - last || 0); last = t;
    mx += (tmx - mx) * 0.05;
    const { W, H } = fitCanvas(cv);
    if (playing) { slideT += dt; (thumbs[idx].firstElementChild as HTMLElement).style.transform = `scaleX(${clamp(slideT / DUR, 0, 1)})`; if (slideT > DUR) go(idx + 1); }
    fadeT = Math.min(1, fadeT + dt / 1.2);
    if (fadeT < 1 && prev >= 0) { paintScene(ctx, W, H, scenes[prev], t, mx); ctx.globalAlpha = ease(fadeT); }
    paintScene(ctx, W, H, scenes[idx], t, mx); ctx.globalAlpha = 1;
    aT += dt; if (aT > 0.15 || t === 0) { aT = 0; amb.width = 64; amb.height = 40; actx.drawImage(cv, 0, 0, 64, 40); }
  });
</script>
