---
import Base from '../../layouts/Base.astro';
import Visual from '../../components/Visual.astro';
import LocatorMap from '../../components/LocatorMap.astro';
import { ITINERARIES } from '../../data/itineraries';
import { FEES } from '../../data/guide';
import { fmt, url } from '../../lib/site';
const desc = 'Four ready-made Bhutan itineraries from 5 to 12 nights, with day-by-day routes, maps and government-fee estimates.';
const stops = (slug: string) => [...new Set(ITINERARIES.find((i) => i.slug === slug)!.days.flatMap((d) => d.places ?? []))];
---
<Base title="Itineraries" description={desc}>
  <section class="wrap head">
    <span class="eyebrow">Ready-made routes</span>
    <h1 class="display">Pick a route</h1>
    <p class="lede">Four tried-and-tested trips. Each one can be booked through any licensed Bhutanese operator and adjusted to your dates, pace and the festival calendar.</p>
  </section>
  <section class="wrap list" aria-label="Itineraries">
    {ITINERARIES.map((it) => (
      <article class="it reveal">
        <a class="media" href={url(`/itineraries/${it.slug}/`)} tabindex="-1" aria-hidden="true"><Visual scene={it.scene} label={it.name} still /></a>
        <div class="body">
          <span class="eyebrow">{it.nights} nights · {it.style}</span>
          <h2><a href={url(`/itineraries/${it.slug}/`)}>{it.name}</a></h2>
          <p>{it.summary}</p>
          <dl class="facts">
            <dt>Best for</dt><dd>{it.bestFor}</dd>
            <dt>Seasons</dt><dd>{it.seasons}</dd>
            <dt>SDF per adult</dt><dd class="mono">USD {fmt(it.nights * FEES.sdfUsd)}</dd>
          </dl>
          <a class="btn" href={url(`/itineraries/${it.slug}/`)}>Day by day</a>
        </div>
        <LocatorMap highlight={stops(it.slug)} route label={`${it.name} route`} />
      </article>
    ))}
  </section>
</Base>

<style>
  .head { display: grid; gap: 18px; padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 80px)); padding-bottom: clamp(32px, 4vw, 56px); }
  h1 { font-size: clamp(2.6rem, 7vw, 6rem); }
  .list { display: grid; gap: 24px; padding-bottom: clamp(72px, 10vw, 140px); }
  .it { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(16px, 2.5vw, 32px); padding: clamp(16px, 2vw, 24px); border: 1px solid var(--line); border-radius: var(--radius); background: var(--slate); align-items: start; }
  .media { display: block; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; max-width: 100%; }
  .body { display: grid; gap: 14px; justify-items: start; }
  h2 { font-family: var(--display); font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1; margin: 0; }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--saffron-hi); }
  .body > p { color: var(--mist); }
  @media (max-width: 1100px) { .it { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .it :global(.loc) { grid-column: 1 / -1; } }
  @media (max-width: 700px) { .it { grid-template-columns: minmax(0, 1fr); } }
</style>
