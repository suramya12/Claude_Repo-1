---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LocatorMap from '../../components/LocatorMap.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { PLACES, CATEGORIES, nearby, type Place } from '../../data/places';
import { WONDERS, wonderIndex } from '../../data/wonders';
import { MONTHS } from '../../data/festivals';
import { ITINERARIES } from '../../data/itineraries';
import { TREKS } from '../../data/mountains';
import { url } from '../../lib/site';

export function getStaticPaths() {
  return PLACES.map((p) => ({ params: { slug: p.slug }, props: { place: p } }));
}
interface Props { place: Place }
const { place: p } = Astro.props;
const wi = wonderIndex(p.slug);
const wonder = wi >= 0 ? WONDERS[wi] : undefined;
const fests = MONTHS.flatMap((m) => m.festivals.filter((f) => f.place === p.slug).map((f) => ({ ...f, month: m.name })));
const its = ITINERARIES.filter((it) => it.days.some((d) => d.places?.includes(p.slug)));
const treks = TREKS.filter((t) => t.places.includes(p.slug));
const near = nearby(p, 3);
const i = PLACES.indexOf(p);
const prev = PLACES[(i - 1 + PLACES.length) % PLACES.length], next = PLACES[(i + 1) % PLACES.length];
const jsonld = {
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: p.name, description: p.summary,
  geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lon },
  containedInPlace: { '@type': 'Country', name: 'Bhutan' },
};
const crumbsLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Places', item: new URL(url('/places/'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.name },
  ],
};
---
<Base title={p.name} description={p.summary} type="article" image={`/og/${wi >= 0 ? p.slug : 'default'}.png`} jsonld={[jsonld, crumbsLd]}>
  <PageHero
    slug={p.slug}
    label={`${p.name}, illustrated`}
    eyebrow={`${CATEGORIES[p.cat].label}${wonder ? ` · Wonder ${String(wi + 1).padStart(2, '0')} of 07` : ''}`}
    title={p.name}
    tib={p.tib}
    lede={p.summary}
    crumbs={[['/places/', 'Places'], ['', p.name]]}
  >
    {wonder && <div class="stats hero-stats">{wonder.stats.map(([v, u, l]) => <div><b>{v}{u && <small>{u}</small>}</b><span>{l}</span></div>)}</div>}
  </PageHero>

  <div class="wrap sec-tight layout">
    <article class="prose main">
      {p.body.map((para) => <p>{para}</p>)}
      <h2>Highlights</h2>
      <ul>{p.highlights.map((h) => <li>{h}</li>)}</ul>
      <div class="callout"><b>LOCAL TIP</b>{p.tip}</div>
      {fests.length > 0 && (
        <>
          <h2>Festivals here</h2>
          <ul class="plain">{fests.map((f) => <li><strong>{f.name}</strong> <span class="mono when">{f.date}</span><br />{f.text}</li>)}</ul>
          <p><a href={url('/festivals/')}>See the full festival calendar</a></p>
        </>
      )}
      {treks.length > 0 && (
        <>
          <h2>Treks that pass through</h2>
          <ul class="plain">{treks.map((t) => <li><a href={url(`/mountains/#${t.slug}`)}>{t.name}</a> <span class="mono when">{t.days} · {t.grade}</span></li>)}</ul>
        </>
      )}
      {its.length > 0 && (
        <>
          <h2>Itineraries that include {p.name}</h2>
          <ul class="plain">{its.map((it) => <li><a href={url(`/itineraries/${it.slug}/`)}>{it.name}</a> <span class="mono when">{it.nights} nights</span></li>)}</ul>
        </>
      )}
    </article>
    <aside class="side">
      <div class="panel">
        <dl class="facts">
          <dt>Altitude</dt><dd>{p.alt}</dd>
          <dt>District</dt><dd>{p.district}</dd>
          <dt>Region</dt><dd>{p.region} Bhutan</dd>
          <dt>Best time</dt><dd>{p.bestTime}</dd>
          <dt>Time needed</dt><dd>{p.timeNeeded}</dd>
          <dt>Getting there</dt><dd>{p.access}</dd>
          <dt>Coordinates</dt><dd class="mono">{p.lat.toFixed(3)}° N, {p.lon.toFixed(3)}° E</dd>
        </dl>
      </div>
      <LocatorMap highlight={[p.slug]} />
      <a class="btn ghost full" href={url(`/places/#${p.slug}`)}>Open on the interactive map</a>
    </aside>
  </div>

  <section class="wrap sec-tight" aria-labelledby="near-h">
    <div class="sec-head"><span class="eyebrow">Nearby</span><h2 class="display small" id="near-h">Close to {p.name}</h2></div>
    <div class="card-grid">{near.map(({ q, d }) => <PlaceCard place={q} note={`${Math.round(d)} km away`} />)}</div>
    <nav class="pager" aria-label="More places">
      <a href={url(`/places/${prev.slug}/`)} class="link-arrow"><span>←</span> {prev.name}</a>
      <a href={url('/places/')} class="link-arrow">All places</a>
      <a href={url(`/places/${next.slug}/`)} class="link-arrow">{next.name} <span>→</span></a>
    </nav>
  </section>
</Base>

<style>
  .hero-stats { margin-top: 16px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .main > p:first-child { font-size: 1.15em; color: var(--snow); }
  .plain { list-style: none; padding: 0 !important; }
  .plain li { padding: 12px 0; border-top: 1px solid var(--line); }
  .when { font-size: 12px; color: var(--saffron); margin-left: 8px; }
  .side { display: grid; gap: 16px; position: sticky; top: calc(var(--nav-h) + 16px); }
  .full { justify-content: center; }
  .small { font-size: clamp(1.8rem, 4vw, 3rem) !important; }
  .pager { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  @media (max-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { position: static; } }
</style>
